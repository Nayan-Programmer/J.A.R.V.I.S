# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Optional: multiple Groq keys (round-robin) ────────────────────────────────
# GROQ_API_KEY_2=second_key
# GROQ_API_KEY_3=third_key

# ── Optional: Groq model ──────────────────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional: Tavily web search ───────────────────────────────────────────────
# TAVILY_API_KEY=your_tavily_key

# ── Gmail (for emailing PPT presentations) ────────────────────────────────────
# Your Gmail address:
# GMAIL_ADDRESS=yourname@gmail.com
#
# A Gmail App Password (NOT your normal Gmail password).
# Generate at: myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled first)
# GMAIL_APP_PASSWORD=your_16_char_app_password
